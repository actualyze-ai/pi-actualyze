# Workflows, package metadata, and the lockfile decide what CI runs and
# what gets published, so changes to these paths are routed to a release
# approver for review.
/.github/            @actualyze-ai/oss-release-approvers
/package.json        @actualyze-ai/oss-release-approvers
/package-lock.json   @actualyze-ai/oss-release-approvers
